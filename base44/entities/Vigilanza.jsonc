{
  "name": "Vigilanza",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome e cognome del referente vigilanza"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email dell'account vigilanza"
    },
    "invito_accettato": {
      "type": "boolean",
      "default": false,
      "description": "Se ha accettato l'invito e completato la registrazione"
    },
    "centro_preferito_id": {
      "type": "string",
      "description": "ID del centro commerciale preferito (quello che compare all'apertura)"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}