{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "numero_ticket": {
      "type": "string",
      "description": "Numero identificativo del ticket"
    },
    "centro_id": {
      "type": "string",
      "description": "ID del centro commerciale"
    },
    "data_apertura": {
      "type": "string",
      "format": "date",
      "description": "Data di apertura del ticket"
    },
    "operatore": {
      "type": "string",
      "description": "Nome dell'operatore che apre il ticket"
    },
    "tipologia": {
      "type": "string",
      "enum": [
        "ordinario",
        "urgente"
      ],
      "default": "ordinario",
      "description": "Tipologia del ticket"
    },
    "descrizione": {
      "type": "string",
      "description": "Descrizione del ticket"
    },
    "scadenza": {
      "type": "string",
      "format": "date",
      "description": "Data di scadenza del ticket"
    },
    "stato": {
      "type": "string",
      "enum": [
        "in_attesa_approvazione",
        "approvato",
        "approvato_con_preventivo",
        "preventivo_inserito",
        "da_controllare",
        "chiuso",
        "rifiutato"
      ],
      "default": "in_attesa_approvazione",
      "description": "Stato del ticket"
    },
    "numero_sollecito": {
      "type": "number",
      "description": "Numero del sollecito (0 = nessun sollecito)"
    },
    "foto_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL delle foto allegate al ticket"
    },
    "note_manutentore": {
      "type": "string",
      "description": "Note inserite dal manutentore durante l'intervento"
    },
    "allegati_manutentore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allegati caricati dal manutentore"
    },
    "costo_stimato": {
      "type": "number",
      "description": "Costo stimato inserito dal manutentore (preventivo)"
    },
    "preventivo_confermato": {
      "type": "boolean",
      "default": false,
      "description": "Se il preventivo \u00e8 stato confermato dal direttore"
    },
    "motivo_rifiuto": {
      "type": "string",
      "description": "Motivo del rifiuto del ticket"
    },
    "confermato": {
      "type": "boolean",
      "default": false,
      "description": "Se il ticket \u00e8 stato confermato dal direttore (legacy)"
    }
  },
  "required": [
    "numero_ticket",
    "operatore",
    "tipologia",
    "data_apertura"
  ]
}