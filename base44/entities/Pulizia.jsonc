{
  "name": "Pulizia",
  "type": "object",
  "properties": {
    "centro_id": {
      "type": "string",
      "description": "ID del centro commerciale"
    },
    "titolo": {
      "type": "string",
      "description": "Titolo della segnalazione"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data della segnalazione"
    },
    "descrizione": {
      "type": "string",
      "description": "Descrizione della segnalazione"
    },
    "foto_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL delle foto allegate"
    },
    "creato_da_email": {
      "type": "string",
      "description": "Email di chi ha creato la segnalazione"
    },
    "creato_da_nome": {
      "type": "string",
      "description": "Nome di chi ha creato la segnalazione"
    },
    "letto_da": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista delle email dei direttori che hanno letto la segnalazione"
    }
  },
  "required": [
    "centro_id",
    "titolo",
    "data"
  ]
}