{
  "name": "Manutentore",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome e cognome del manutentore"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email dell'account manutentore"
    },
    "azienda": {
      "type": "string",
      "description": "Nome dell'azienda di manutenzione"
    },
    "invito_accettato": {
      "type": "boolean",
      "default": false,
      "description": "Se ha accettato l'invito e completato la registrazione"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}