{
  "name": "Fornitore",
  "type": "object",
  "properties": {
    "centro_id": {
      "type": "string",
      "description": "ID del centro commerciale"
    },
    "nome_ditta": {
      "type": "string",
      "description": "Nome della ditta fornitrice"
    },
    "partita_iva": {
      "type": "string",
      "description": "Partita IVA della ditta"
    },
    "pec": {
      "type": "string",
      "description": "PEC della ditta"
    },
    "indirizzo": {
      "type": "string",
      "description": "Via/indirizzo della sede legale"
    },
    "citta": {
      "type": "string",
      "description": "Citt\u00e0 della sede legale"
    },
    "referente_nome": {
      "type": "string",
      "description": "Nome del referente"
    },
    "referente_email": {
      "type": "string",
      "format": "email",
      "description": "Email del referente"
    },
    "referente_telefono": {
      "type": "string",
      "description": "Numero di cellulare del referente"
    },
    "lavoratori": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome del lavoratore"
          },
          "mansione": {
            "type": "string",
            "description": "Mansione/ruolo del lavoratore"
          }
        },
        "required": [
          "nome"
        ]
      },
      "description": "Lista dei lavoratori"
    },
    "duvri_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL dei DUVRI (Documento Unico di Valutazione dei Rischi di Interferenza)"
    },
    "dpi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista dei Dispositivi di Protezione Individuale previsti"
    },
    "subornitori": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome_ditta": {
            "type": "string",
            "description": "Nome della ditta subfornitrice"
          },
          "referente_nome": {
            "type": "string",
            "description": "Nome del referente"
          },
          "referente_email": {
            "type": "string",
            "format": "email",
            "description": "Email del referente"
          },
          "referente_telefono": {
            "type": "string",
            "description": "Numero di cellulare del referente"
          },
          "lavoratori": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string"
                },
                "mansione": {
                  "type": "string"
                }
              },
              "required": [
                "nome"
              ]
            },
            "description": "Lavoratori del subfornitore"
          },
          "duvri_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URL dei DUVRI del subfornitore"
          }
        },
        "required": [
          "nome_ditta"
        ]
      },
      "description": "Lista dei subornitori"
    },
    "note": {
      "type": "string",
      "description": "Note aggiuntive"
    }
  },
  "required": [
    "centro_id",
    "nome_ditta",
    "referente_nome"
  ]
}