{
  "name": "Report",
  "type": "object",
  "properties": {
    "centro_id": {
      "type": "string",
      "description": "ID del centro commerciale"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data del report"
    },
    "operatore": {
      "type": "string",
      "description": "Cognome dell'operatore (es. Rossi)"
    },
    "contenuto": {
      "type": "string",
      "description": "Contenuto del report"
    },
    "furto": {
      "type": "boolean",
      "default": false,
      "description": "Se durante il turno si \u00e8 verificato un furto"
    },
    "foto_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL delle foto allegate al report"
    },
    "creato_da_email": {
      "type": "string",
      "description": "Email di chi ha creato il report"
    },
    "letto_da": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista delle email dei direttori che hanno letto il report"
    }
  },
  "required": [
    "centro_id",
    "data",
    "operatore"
  ]
}