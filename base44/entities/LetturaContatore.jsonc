{
  "name": "LetturaContatore",
  "type": "object",
  "properties": {
    "centro_id": {
      "type": "string",
      "description": "ID del centro commerciale"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "acqua",
        "energia",
        "gas",
        "fotovoltaico"
      ],
      "description": "Tipo di contatore"
    },
    "nome": {
      "type": "string",
      "description": "Nome del contatore o sottocontatore"
    },
    "contatore_padre_id": {
      "type": "string",
      "description": "ID del contatore padre (null se contatore principale)"
    },
    "anno": {
      "type": "number",
      "description": "Anno di riferimento"
    },
    "costo_unitario": {
      "type": "number",
      "description": "Costo unitario per unita di consumo (es. \u20ac/m\u00b3, \u20ac/kWh)"
    },
    "lettura_iniziale": {
      "type": "number",
      "description": "Lettura iniziale (fine anno precedente)"
    },
    "gen": {
      "type": "number",
      "description": "Lettura Gennaio"
    },
    "feb": {
      "type": "number",
      "description": "Lettura Febbraio"
    },
    "mar": {
      "type": "number",
      "description": "Lettura Marzo"
    },
    "apr": {
      "type": "number",
      "description": "Lettura Aprile"
    },
    "mag": {
      "type": "number",
      "description": "Lettura Maggio"
    },
    "giu": {
      "type": "number",
      "description": "Lettura Giugno"
    },
    "lug": {
      "type": "number",
      "description": "Lettura Luglio"
    },
    "ago": {
      "type": "number",
      "description": "Lettura Agosto"
    },
    "set": {
      "type": "number",
      "description": "Lettura Settembre"
    },
    "ott": {
      "type": "number",
      "description": "Lettura Ottobre"
    },
    "nov": {
      "type": "number",
      "description": "Lettura Novembre"
    },
    "dic": {
      "type": "number",
      "description": "Lettura Dicembre"
    },
    "costo_gen": {
      "type": "number",
      "description": "Costo Gennaio (inserito manualmente, indipendente dai consumi)"
    },
    "costo_feb": {
      "type": "number",
      "description": "Costo Febbraio (inserito manualmente, indipendente dai consumi)"
