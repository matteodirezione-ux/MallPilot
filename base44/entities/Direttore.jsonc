{
  "name": "Direttore",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome e cognome del direttore"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email del direttore"
    },
    "invito_accettato": {
      "type": "boolean",
      "default": false,
      "description": "Se il direttore ha accettato l'invito e completato la registrazione"
    },
    "centro_preferito_id": {
      "type": "string",
      "description": "ID del centro commerciale preferito (quello che compare all'apertura)"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}