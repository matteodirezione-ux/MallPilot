{
  "name": "Capex",
  "type": "object",
  "properties": {
    "centro_id": {
      "type": "string",
      "description": "ID del centro commerciale"
    },
    "titolo": {
      "type": "string",
      "description": "Titolo dell'intervento Capex"
    },
    "anno_capex": {
      "type": "number",
      "description": "Anno di riferimento del Capex (per la lista)"
    },
    "descrizione": {
      "type": "string",
      "description": "Descrizione dell'intervento"
    },
    "data_inizio": {
      "type": "string",
      "format": "date",
      "description": "Data di inizio intervento programmato (visibile nel calendario)"
    },
    "data_fine": {
      "type": "string",
      "format": "date",
      "description": "Data di fine intervento programmato"
    },
    "costo_previsto": {
      "type": "number",
      "description": "Costo previsto dell'intervento"
    },
    "costo_effettivo": {
      "type": "number",
      "description": "Costo effettivo a consuntivo"
    },
    "stato": {
      "type": "string",
      "enum": [
        "da_proporre",
        "da_pianificare",
        "pianificato",
        "completato"
      ],
      "default": "da_pianificare",
      "description": "Stato dell'intervento"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "strutturale",
        "impiantistico",
        "tecnologico",
        "estetico",
        "sicurezza",
        "altro"
      ],
      "default": "altro",
      "description": "Categoria dell'intervento"
    },
    "fornitore": {
      "type": "string",
      "description": "Nome del fornitore/appaltatore"
    },
    "note": {
      "type": "string",
      "description": "Note aggiuntive"
    },
    "allegati_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL degli allegati/foto caricati"
    },
    "duvri_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL dei DUVRI caricati"
    },
    "cse": {
      "type": "boolean",
      "default": false,
      "description": "Se true, \u00e8 presente un CSE che sostituisce il DUVRI (non scatta l'alert DUVRI mancante)"
    },
    "lavoratori": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "mansione": {
            "type": "string"
          }
        },
        "required": [
          "nome"
        ]
      },
      "description": "Lista dei lavoratori"
    },
    "dpi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista dei Dispositivi di Protezione Individuale"
    }
  },
  "required": [
    "centro_id",
    "titolo",
    "anno_capex"
  ]
}