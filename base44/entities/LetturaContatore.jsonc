    },
    "costo_mag": {
      "type": "number",
      "description": "Costo Maggio (inserito manualmente, indipendente dai consumi)"
    },
    "costo_giu": {
      "type": "number",
      "description": "Costo Giugno (inserito manualmente, indipendente dai consumi)"
    },
    "costo_lug": {
      "type": "number",
      "description": "Costo Luglio (inserito manualmente, indipendente dai consumi)"
